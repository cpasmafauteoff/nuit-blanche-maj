; Fichier de configuration du moteur Godot.

config_version=5

[application]

config/name="Nuit Blanche"
run/main_scene="res://principal.tscn"
boot_splash/bg_color=Color(0.027, 0.035, 0.07, 1)
boot_splash/show_image=true
boot_splash/image="res://images/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

MiseAJour="*res://mise_a_jour.gd"
Capteur="*res://capteur.gd"
Regard="*res://regard.gd"
Reseau="*res://reseau.gd"
Voix="*res://voix.gd"
Lobbies="*res://annuaire.gd"
Visages="*res://portraits.gd"
Options="*res://reglages.gd"
Pad="*res://manette.gd"
Plateforme="*res://plateforme.gd"
Streamer="*res://streamer.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://polices/IMFell-Regular.ttf"

[internationalization]

locale/fallback="fr"

[rendering]

anti_aliasing/quality/msaa_3d=2

[audio]

driver/enable_input=true
